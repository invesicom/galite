{
  "name": "open-galite",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^20.19.6 || >=22.12.0 <23"
  },
  "scripts": {
    "dev": "./dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy": "nuxt build && wrangler deploy && echo \"\\n✅ Deployed at $(date '+%Y-%m-%d %H:%M:%S')\"",
    "postinstall": "nuxt prepare",
    "db:gen": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply open-galite --local",
    "db:migrate:remote": "wrangler d1 migrations apply open-galite --remote"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "drizzle-orm": "^0.44.2",
    "html2canvas-pro": "^2.0.3",
    "lodash": "^4.18.1",
    "marked": "^18.0.3",
    "nuxt": "3.21.4",
    "pinia": "^3.0.4",
    "vue": "3.5.34",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@intlify/core": "10.0.8",
    "@intlify/core-base": "10.0.8",
    "@intlify/message-compiler": "10.0.8",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/i18n": "9.5.6",
    "@tailwindcss/vite": "4.3.0",
    "drizzle-kit": "^0.31.1",
    "tailwindcss": "4.3.0",
    "wrangler": "^4.54.0"
  }
}
